# Local-only development configuration for the embeddable VoiceSupportButton.
# Copy this file to .env and adjust values -- .env itself is git-ignored.

# Base URL of the local FastAPI backend.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Fictional local-only demo bearer token. This simulates the customer
# session a real retailer app would already have. It is NOT a real
# credential and only works against this repository's demo auth adapter
# (backend/app/services/demo_auth.py).
#
# Switch between these to test different customer accounts:
#   demo-cust-101  Test Customer One  -- one order (ORD-5001)
#   demo-cust-102  Test Customer Two  -- two orders (ORD-5002, ORD-5003)
#   demo-cust-103  Test Customer Three -- no orders
VITE_DEMO_AUTH_TOKEN=demo-cust-101
